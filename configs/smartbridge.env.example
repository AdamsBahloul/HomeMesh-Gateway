# ==============================================================================
# SmartBridge OS (HomeMesh Gateway) Master Configuration Environment File
# ==============================================================================

# Project General
PROJECT_NAME="SmartBridge OS"
ENVIRONMENT="development" # development | staging | production
LOG_LEVEL="INFO"

# FastAPI Backend Configuration
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-signing-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="smartbridge"
POSTGRES_PASSWORD="smartbridge_secure_password"
POSTGRES_DB="smartbridge_db"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis Cache & Message Queue
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/0"

# Mosquitto MQTT Broker
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USER="gateway_service"
MQTT_PASSWORD="mqtt_gateway_password"
MQTT_USE_TLS=true
MQTT_CA_CERT="/etc/mosquitto/certs/ca.crt"
MQTT_CLIENT_CERT="/etc/mosquitto/certs/client.crt"
MQTT_CLIENT_KEY="/etc/mosquitto/certs/client.key"

# Embedded Linux Gateway Service
GATEWAY_SERIAL_PORT="/dev/ttyAMA0" # Raspberry Pi UART serial port
GATEWAY_BAUD_RATE=115200
GATEWAY_NODE_ID="gw-rpi5-01"
GATEWAY_HEALTH_INTERVAL_SEC=10

# OTA Updates & Firmware Signer
FIRMWARE_STORAGE_PATH="/var/smartbridge/firmware"
OTA_SIGNING_PRIVATE_KEY="/etc/smartbridge/keys/firmware_rsa_priv.pem"
OTA_CHUNK_SIZE_BYTES=256

# Edge AI Configuration
EDGE_AI_ENABLED=true
EDGE_AI_ANOMALY_THRESHOLD=0.85
